{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$EXE/packages" }, { "path": "$EXE/packages/**" }]
    },
    {
      "identifier": "fs:allow-read",
      "allow": [{ "path": "$EXE/packages/**" }]
    }
  ]
}